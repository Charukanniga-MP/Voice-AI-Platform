# =============================================================================
# KAIRA Voice AI – Production Environment Variables Template
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
PUBLIC_URL=

# HTTPS / SSL Deployment Configuration (Mandatory for mobile device microphone access)
# Set HTTPS=true to run Node.js directly on HTTPS using PFX or PEM certificates.
# If behind a reverse proxy (Caddy/Nginx), leave HTTPS=false and let the proxy terminate SSL.
HTTPS=false
SSL_CERT_PATH=ssl/cert.pem
SSL_KEY_PATH=ssl/key.pem
SSL_PFX_PATH=ssl/server.pfx
SSL_PASSPHRASE=kaira123

# Security & Authentication (Required - Min 32 characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-characters-long

# Database Connection (Default SQLite for dev/pilot; PostgreSQL recommended for high concurrency)
# DATABASE_URL="postgresql://user:password@localhost:5432/kaira?schema=public"

# AI Engine Configuration
# When funded with credits, KAIRA uses GPT-4o-mini for dynamic voice responses.
# When quota is exceeded or offline, KAIRA automatically uses its built-in zero-hallucination heuristic NLP engine.
OPENAI_API_KEY=your-openai-api-key-here

# Twilio Telephony Credentials (Required for real mobile carrier phone calls)
# WebRTC browser calling works without Twilio. PSTN carrier dialing requires:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=+15551234567
NGROK_URL=

# WebRTC Network Traversal (TURN Relay for mobile cellular & symmetric NAT firewalls)
# If Twilio is configured, Twilio NTS is used automatically. Otherwise, specify Coturn/Metered:
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Transactional Email Service (Optional - for automated password reset dispatch)
# If unconfigured, the portal displays truthful administrator-assisted reset guidance.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=support@kaira.com
