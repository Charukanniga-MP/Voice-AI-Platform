# =============================================================================
# KAIRA Voice AI Platform – Environment Configuration Template
# =============================================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# JWT Secret & Session Expiration (Use a strong 64-char random string in production)
JWT_SECRET=replace-with-a-cryptographically-secure-secret-key-min-32-chars
JWT_EXPIRES_IN=2h

# Application URLs (Used for CORS, redirects, and password recovery links)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Prisma SQLite Database (Handled automatically by Prisma schema)
# DATABASE_URL="file:./dev.db"

# =============================================================================
# Google OAuth 2.0 / Google Identity Services (GIS)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# =============================================================================
# SMTP Email Service Configuration (For Password Reset & Notifications)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=KAIRA Support <no-reply@kaira.ai>

# =============================================================================
# Security & Rate Limiting Controls
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
TRUST_PROXY=false
