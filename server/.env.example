# =============================================================================
# KAIRA Voice AI Platform – Environment Configuration Template
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
PUBLIC_URL=

# HTTPS / SSL Deployment Configuration (Mandatory for mobile device microphone access)
# Set HTTPS=true to run Node.js directly on HTTPS using PFX or PEM certificates.
# If behind a reverse proxy (Caddy/Nginx), leave HTTPS=false and let the proxy terminate SSL.
HTTPS=false
SSL_CERT_PATH=ssl/cert.pem
SSL_KEY_PATH=ssl/key.pem
SSL_PFX_PATH=ssl/server.pfx
SSL_PASSPHRASE=kaira123

# JWT Secret & Session Expiration (Use a strong 64-char random string in production)
JWT_SECRET=replace-with-a-cryptographically-secure-secret-key-min-32-chars
JWT_EXPIRES_IN=2h

# Google OAuth 2.0 / Google Identity Services (GIS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# AI Engine Configuration
# When funded with credits, KAIRA uses GPT-4o-mini for dynamic voice responses.
# When quota is exceeded or offline, KAIRA automatically uses its built-in zero-hallucination heuristic NLP engine.
OPENAI_API_KEY=your-openai-api-key-here

# Twilio Telephony Credentials (Required for real mobile carrier phone calls)
# WebRTC browser calling works without Twilio. PSTN carrier dialing requires:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=+15551234567
NGROK_URL=

# WebRTC Network Traversal (TURN Relay for mobile cellular & symmetric NAT firewalls)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Transactional SMTP Email Service Configuration (For Password Reset & Notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=KAIRA Support <no-reply@kaira.ai>

# Security & Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
TRUST_PROXY=false
