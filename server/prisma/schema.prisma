generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String                @id @default(cuid())
  name             String
  email            String                @unique
  phone            String?
  role             String                // "admin" | "agent" | "customer"
  passwordHash     String
  googleId         String?
  avatar           String?
  preferredLanguage String?              @default("en") // "ta" | "en" | "te" | "ml" | "hi"
  supportedLanguages String?             @default("en,ta,te,ml,hi") // for agents
  agentStatus      String?               @default("available") // "available" | "busy" | "offline"
  maxConcurrentCalls Int                 @default(1)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  callsAsCustomer  CallRecord[]          @relation("CustomerCalls")
  callsAsAgent     CallRecord[]          @relation("AgentCalls")
  callsAsAdmin     CallRecord[]          @relation("AdminCalls")
  transferRequests CallTransferRequest[]
  assignedTasks    FollowUpTask[]        @relation("AssignedFollowUpTasks")
  customerTasks    FollowUpTask[]        @relation("CustomerFollowUpTasks")
}

model CallRecord {
  id               String                @id @default(cuid())
  callId           String                @unique
  customerId       String?
  customer         User?                 @relation("CustomerCalls", fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerPhone    String?
  agentId          String?
  agent            User?                 @relation("AgentCalls", fields: [agentId], references: [id], onDelete: SetNull)
  agentName        String?
  adminId          String?
  admin            User?                 @relation("AdminCalls", fields: [adminId], references: [id], onDelete: SetNull)
  type             String                // "ai_voice" | "agent_voice" | "admin_transfer"
  direction        String                // "incoming" | "outgoing"
  status           String                // "queued" | "ringing" | "active" | "completed" | "missed" | "transferred" | "rejected"
  language         String?               @default("en") // "ta" | "en" | "te" | "ml" | "hi"
  startTime        DateTime              @default(now())
  endTime          DateTime?
  duration         Int                   @default(0) // seconds
  queueDuration    Int                   @default(0) // seconds in queue
  transferred      Boolean               @default(false)
  transferReason   String?
  customerQuestion String?
  callNotes        String?
  endedBy          String?               // "customer" | "agent" | "network" | "system"
  rating           Int?
  providerCallSid  String?               @unique
  providerName     String?               @default("twilio")
  failureReason    String?

  // Call Quality & Reliability metrics
  quality          String?               @default("good") // "excellent" | "good" | "poor"
  avgLatency       Float?                // milliseconds (RTT)
  packetLoss       Float?                // percentage (0 - 100%)
  jitter           Float?                // milliseconds
  reconnectCount   Int                   @default(0)
  wasReconnected   Boolean               @default(false)
  audioQualityScore Float?               // estimated MOS score (1.0 - 5.0)

  createdAt        DateTime              @default(now())

  transcripts      CallTranscript[]
  transferRequests CallTransferRequest[]
  intelligence     CallIntelligence?
  followUpTasks    FollowUpTask[]
}

model CallTranscript {
  id           String     @id @default(cuid())
  callRecordId String
  callRecord   CallRecord @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  sender       String     // "customer" | "ai" | "agent" | "admin" | "system"
  senderName   String?
  text         String
  translation  String?
  language     String?
  timestamp    DateTime   @default(now())
}

model CallTransferRequest {
  id            String      @id @default(cuid())
  callRecordId  String
  callRecord    CallRecord  @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      User?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  question      String
  reason        String
  status        String      // "pending" | "ringing" | "accepted" | "connected" | "rejected" | "missed" | "completed"
  adminId       String?
  createdAt     DateTime    @default(now())
  respondedAt   DateTime?
}

model KnowledgeDocument {
  id            String           @id @default(cuid())
  title         String
  fileName      String
  fileType      String
  fileSize      Int
  status        String           // "processing" | "indexed" | "failed"
  extractedText String
  entryCount    Int              @default(0)
  createdAt     DateTime         @default(now())

  entries       KnowledgeEntry[]
}

model KnowledgeEntry {
  id          String             @id @default(cuid())
  documentId  String?
  document    KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title       String
  category    String             // "company" | "products" | "services" | "pricing" | "policies" | "faq" | "support" | "general"
  question    String?
  answer      String?
  content     String
  keywords    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model SupportTicket {
  id             String   @id @default(cuid())
  customerId     String?
  customerName   String
  customerEmail  String?
  subject        String
  description    String
  priority       String   @default("medium")
  status         String   @default("open")
  assignedTo     String?
  followUpAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CallIntelligence {
  id                    String      @id @default(cuid())
  callRecordId          String      @unique
  callRecord            CallRecord  @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  customerId            String?
  customerName          String
  agentId               String?
  agentName             String?
  duration              Int         @default(0) // in seconds
  language              String      @default("en")
  callReason            String      // Main reason for calling
  customerQuestions     String      // JSON array of strings
  solutionsProvided     String      // JSON array of strings
  kbSourcesUsed         String?     // JSON array of sources
  resolutionStatus      String      // "resolved" | "partially_resolved" | "unresolved" | "escalated_admin"
  resolutionExplanation String      // Supporting explanation for classification
  unresolvedQuestions   String?     // JSON array of strings
  actionItems           String?     // JSON array of required follow-up actions
  overallSummary        String      // English structured summary
  sentiment             String?     @default("neutral") // "positive" | "neutral" | "negative"
  processingStatus      String      @default("completed") // "pending" | "processing" | "completed" | "failed"
  errorMessage          String?
  retryCount            Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model FollowUpTask {
  id                 String      @id @default(cuid())
  callRecordId       String
  callRecord         CallRecord  @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           User?       @relation("CustomerFollowUpTasks", fields: [customerId], references: [id], onDelete: SetNull)
  customerName       String
  customerPhone      String?
  customerEmail      String?
  assignedAgentId    String?
  assignedAgent      User?       @relation("AssignedFollowUpTasks", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedAgentName  String?
  title              String
  unresolvedQuestion String
  previousSummary    String
  actionRequired     String
  priority           String      @default("medium") // "low" | "medium" | "high" | "urgent"
  status             String      @default("pending") // "pending" | "in_progress" | "completed" | "cancelled"
  language           String?     @default("en")
  notes              String?
  resolutionNotes    String?
  resolvedAt         DateTime?
  resolvedBy         String?
  dueDate            DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([callRecordId, unresolvedQuestion])
}

model KnowledgeGap {
  id                 String      @id @default(cuid())
  question           String
  normalizedQuestion String      @unique
  language           String      @default("en")
  frequency          Int         @default(1)
  topic              String      @default("General")
  sampleCallId       String?
  status             String      @default("open") // "open" | "in_review" | "added_to_kb" | "dismissed"
  lastAskedAt        DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

