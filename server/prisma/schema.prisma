generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String                @id @default(cuid())
  name             String
  email            String                @unique
  phone            String?
  role             String                // "admin" | "agent" | "customer"
  passwordHash     String
  googleId         String?
  avatar           String?
  preferredLanguage String?              @default("en") // "ta" | "en" | "te" | "ml" | "hi"
  supportedLanguages String?             @default("en,ta,te,ml,hi") // for agents
  agentStatus      String?               @default("available") // "available" | "busy" | "offline"
  maxConcurrentCalls Int                 @default(1)
  failedLoginAttempts Int                 @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  callsAsCustomer  CallRecord[]          @relation("CustomerCalls")
  callsAsAgent     CallRecord[]          @relation("AgentCalls")
  callsAsAdmin     CallRecord[]          @relation("AdminCalls")
  transferRequests CallTransferRequest[]
  passwordResetTokens PasswordResetToken[]
  auditLogs        SecurityAuditLog[]
  sentimentRecords SentimentAnalysis[]
}

model CallRecord {
  id               String                @id @default(cuid())
  callId           String                @unique
  customerId       String?
  customer         User?                 @relation("CustomerCalls", fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerPhone    String?
  agentId          String?
  agent            User?                 @relation("AgentCalls", fields: [agentId], references: [id], onDelete: SetNull)
  agentName        String?
  adminId          String?
  admin            User?                 @relation("AdminCalls", fields: [adminId], references: [id], onDelete: SetNull)
  type             String                // "ai_voice" | "agent_voice" | "admin_transfer"
  direction        String                // "incoming" | "outgoing"
  status           String                // "queued" | "ringing" | "active" | "completed" | "missed" | "transferred" | "rejected"
  language         String?               @default("en") // "ta" | "en" | "te" | "ml" | "hi"
  startTime        DateTime              @default(now())
  endTime          DateTime?
  duration         Int                   @default(0) // seconds
  queueDuration    Int                   @default(0) // seconds in queue
  transferred      Boolean               @default(false)
  transferReason   String?
  customerQuestion String?
  callNotes        String?
  endedBy          String?               // "customer" | "agent" | "network" | "system"
  rating           Int?
  providerCallSid  String?               @unique
  providerName     String?               @default("twilio")
  failureReason    String?
  overallSentiment String?               // "POSITIVE" | "NEGATIVE" | "NEUTRAL" | "FRUSTRATED"
  sentimentScore   Float?
  requiresAssistance Boolean             @default(false)
  assistanceReason String?
  assistanceStatus String?               @default("none") // "none" | "pending" | "accepted" | "dismissed"
  createdAt        DateTime              @default(now())

  transcripts      CallTranscript[]
  transferRequests CallTransferRequest[]
  sentimentRecords SentimentAnalysis[]
}

model CallTranscript {
  id           String     @id @default(cuid())
  callRecordId String
  callRecord   CallRecord @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  sender       String     // "customer" | "ai" | "agent" | "admin" | "system"
  senderName   String?
  text         String
  translation  String?
  language     String?
  timestamp    DateTime   @default(now())
}

model CallTransferRequest {
  id            String      @id @default(cuid())
  callRecordId  String
  callRecord    CallRecord  @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      User?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  question      String
  reason        String
  status        String      // "pending" | "ringing" | "accepted" | "connected" | "rejected" | "missed" | "completed"
  priority      String?     @default("normal") // "normal" | "urgent"
  sentiment     String?     // "FRUSTRATED" | "NEGATIVE" | "NEUTRAL" | "POSITIVE"
  adminId       String?
  createdAt     DateTime    @default(now())
  respondedAt   DateTime?
}

model KnowledgeDocument {
  id            String           @id @default(cuid())
  title         String
  fileName      String
  fileType      String
  fileSize      Int
  status        String           // "processing" | "indexed" | "failed"
  extractedText String
  entryCount    Int              @default(0)
  createdAt     DateTime         @default(now())

  entries       KnowledgeEntry[]
}

model KnowledgeEntry {
  id          String             @id @default(cuid())
  documentId  String?
  document    KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title       String
  category    String             // "company" | "products" | "services" | "pricing" | "policies" | "faq" | "support" | "general"
  question    String?
  answer      String?
  content     String
  keywords    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model SupportTicket {
  id             String   @id @default(cuid())
  customerId     String?
  customerName   String
  customerEmail  String?
  subject        String
  description    String
  priority       String   @default("normal")
  status         String   @default("open")
  assignedTo     String?
  followUpAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId, expiresAt])
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  eventType String   // "LOGIN_FAILED" | "LOGIN_SUCCESS" | "RATE_LIMIT_EXCEEDED" | "PASSWORD_RESET_REQUESTED" | "PASSWORD_RESET_SUCCESS" | "UNAUTHORIZED_ACCESS_ATTEMPT"
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([userId])
}

model SentimentAnalysis {
  id                      String      @id @default(cuid())
  callRecordId            String
  callRecord              CallRecord  @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  customerId              String?
  customer                User?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sentiment               String      // "POSITIVE" | "NEGATIVE" | "NEUTRAL" | "FRUSTRATED"
  confidenceScore         Float       // 0.0 to 1.0
  reason                  String?
  triggerText             String?
  language                String?     @default("en") // "en" | "ta" | "te" | "ml" | "hi"
  requiresHumanAssistance Boolean     @default(false)
  isFinal                 Boolean     @default(false)
  customerExperienceNote  String?
  detectedAt              DateTime    @default(now())

  @@index([callRecordId])
  @@index([sentiment, detectedAt])
  @@index([customerId])
}


