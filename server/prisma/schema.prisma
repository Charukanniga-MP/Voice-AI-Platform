generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                 String                @id @default(cuid())
  name               String
  email              String                @unique
  phone              String?
  role               String                // "admin" | "agent" | "customer"
  passwordHash       String
  googleId           String?
  avatar             String?
  preferredLanguage  String?               @default("en") // "ta" | "en" | "te" | "ml" | "hi"
  supportedLanguages String?               @default("en,ta,te,ml,hi") // for agents
  agentStatus        String?               @default("available") // "available" | "busy" | "offline"
  maxConcurrentCalls Int                   @default(1)
  failedLoginAttempts Int                  @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  callsAsCustomer    CallRecord[]          @relation("CustomerCalls")
  callsAsAgent       CallRecord[]          @relation("AgentCalls")
  callsAsAdmin       CallRecord[]          @relation("AdminCalls")
  transferRequests   CallTransferRequest[]
  assignedTasks      FollowUpTask[]        @relation("AssignedFollowUpTasks")
  customerTasks      FollowUpTask[]        @relation("CustomerFollowUpTasks")
  passwordResetTokens PasswordResetToken[]
  auditLogs          SecurityAuditLog[]
  sentimentRecords   SentimentAnalysis[]
  agentEvaluations   AgentPerformanceEvaluation[]
}

model CallRecord {
  id                 String                @id @default(cuid())
  callId             String                @unique
  customerId         String?
  customer           User?                 @relation("CustomerCalls", fields: [customerId], references: [id], onDelete: SetNull)
  customerName       String
  customerPhone      String?
  agentId            String?
  agent              User?                 @relation("AgentCalls", fields: [agentId], references: [id], onDelete: SetNull)
  agentName          String?
  adminId            String?
  admin              User?                 @relation("AdminCalls", fields: [adminId], references: [id], onDelete: SetNull)
  adminName          String?
  adminSessionId     String?
  adminOperatorName  String?
  type               String                // "ai_voice" | "agent_voice" | "admin_transfer"
  direction          String                // "incoming" | "outgoing"
  status             String                // "queued" | "ringing" | "active" | "completed" | "missed" | "transferred" | "rejected"
  language           String?               @default("en") // "ta" | "en" | "te" | "ml" | "kn" | "hi"
  startTime          DateTime              @default(now())
  endTime            DateTime?
  duration           Int                   @default(0) // seconds
  queueDuration      Int                   @default(0) // seconds in queue
  transferred        Boolean               @default(false)
  transferReason     String?
  customerQuestion   String?
  callNotes          String?
  endedBy            String?               // "customer" | "agent" | "network" | "system"
  rating             Int?
  ratingComment      String?
  feedbackFollowUpCompleted Boolean @default(false)
  feedbackFollowUpNotes String?
  providerCallSid    String?               @unique
  providerName       String?               @default("twilio")
  failureReason      String?
  // Call Recording Fields
  recordingUrl       String?
  recordingDuration  Int?                  // duration of recorded audio in seconds
  recordingStatus    String?               @default("none") // "none" | "recording" | "completed" | "failed"
  recordingSizeBytes Int?


  overallSentiment   String?               // "POSITIVE" | "NEGATIVE" | "NEUTRAL" | "FRUSTRATED"
  sentimentScore     Float?
  requiresAssistance Boolean               @default(false)
  assistanceReason   String?
  assistanceStatus   String?               @default("none") // "none" | "pending" | "accepted" | "dismissed"

  // Call Quality & Reliability metrics
  quality            String?               @default("good") // "excellent" | "good" | "poor"
  avgLatency         Float?                // milliseconds (RTT)
  packetLoss         Float?                // percentage (0 - 100%)
  jitter             Float?                // milliseconds
  reconnectCount     Int                   @default(0)
  wasReconnected     Boolean               @default(false)
  audioQualityScore  Float?                // estimated MOS score (1.0 - 5.0)

  createdAt          DateTime              @default(now())

  transcripts        CallTranscript[]
  transferRequests   CallTransferRequest[]
  intelligence       CallIntelligence?
  followUpTasks      FollowUpTask[]
  sentimentRecords   SentimentAnalysis[]
  recording          CallRecording?
  conversationAnalysis ConversationAnalysis?
  agentEvaluation    AgentPerformanceEvaluation?
}

model CallTranscript {
  id           String     @id @default(cuid())
  callRecordId String
  callRecord   CallRecord @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  sender       String     // "customer" | "ai" | "agent" | "admin" | "system"
  senderName   String?
  text         String
  translation  String?
  language     String?
  timestamp    DateTime   @default(now())
  originalText String?
  isCorrected  Boolean    @default(false)
  correctedBy  String?
  correctedAt  DateTime?
}

model CallTransferRequest {
  id                String      @id @default(cuid())
  callRecordId      String
  callRecord        CallRecord  @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          User?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  customerPhone     String?
  question          String
  reason            String
  status            String      // "pending" | "ringing" | "accepted" | "connected" | "rejected" | "missed" | "completed"
  adminId           String?
  adminSessionId    String?
  adminOperatorName String?
  priority          String?     @default("normal") // "normal" | "urgent"
  sentiment         String?     @default("NEUTRAL")
  createdAt         DateTime    @default(now())
  respondedAt       DateTime?
}

model KnowledgeDocument {
  id            String           @id @default(cuid())
  title         String
  fileName      String
  fileType      String
  fileSize      Int
  status        String           // "processing" | "indexed" | "failed"
  extractedText String
  entryCount    Int              @default(0)
  createdAt     DateTime         @default(now())

  entries       KnowledgeEntry[]
}

model KnowledgeEntry {
  id          String             @id @default(cuid())
  documentId  String?
  document    KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title       String
  category    String             // "company" | "products" | "services" | "pricing" | "policies" | "faq" | "support" | "general"
  question    String?
  answer      String?
  content     String
  keywords    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model SupportTicket {
  id             String   @id @default(cuid())
  customerId     String?
  customerName   String
  customerEmail  String?
  subject        String
  description    String
  priority       String   @default("medium")
  status         String   @default("open")
  assignedTo     String?
  followUpAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       SupportTicketMessage[]
}

model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String?
  senderName String
  senderRole String
  message   String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model CallIntelligence {
  id                    String      @id @default(cuid())
  callRecordId          String      @unique
  callRecord            CallRecord  @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  customerId            String?
  customerName          String
  agentId               String?
  agentName             String?
  duration              Int         @default(0) // in seconds
  language              String      @default("en")
  callReason            String      // Main reason for calling
  customerQuestions     String      // JSON array of strings
  solutionsProvided     String      // JSON array of strings
  kbSourcesUsed         String?     // JSON array of sources
  resolutionStatus      String      // "resolved" | "partially_resolved" | "unresolved" | "escalated_admin"
  resolutionExplanation String      // Supporting explanation for classification
  unresolvedQuestions   String?     // JSON array of strings
  actionItems           String?     // JSON array of required follow-up actions
  overallSummary        String      // English structured summary
  sentiment             String?     @default("neutral") // "positive" | "neutral" | "negative"
  processingStatus      String      @default("completed") // "pending" | "processing" | "completed" | "failed"
  errorMessage          String?
  retryCount            Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model FollowUpTask {
  id                 String      @id @default(cuid())
  callRecordId       String
  callRecord         CallRecord  @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           User?       @relation("CustomerFollowUpTasks", fields: [customerId], references: [id], onDelete: SetNull)
  customerName       String
  customerPhone      String?
  customerEmail      String?
  assignedAgentId    String?
  assignedAgent      User?       @relation("AssignedFollowUpTasks", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedAgentName  String?
  title              String
  unresolvedQuestion String
  previousSummary    String
  actionRequired     String
  priority           String      @default("medium") // "low" | "medium" | "high" | "urgent"
  status             String      @default("pending") // "pending" | "in_progress" | "completed" | "cancelled"
  language           String?     @default("en")
  notes              String?
  resolutionNotes    String?
  resolvedAt         DateTime?
  resolvedBy         String?
  dueDate            DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([callRecordId, unresolvedQuestion])
}

model KnowledgeGap {
  id                 String      @id @default(cuid())
  question           String
  normalizedQuestion String      @unique
  language           String      @default("en")
  frequency          Int         @default(1)
  topic              String      @default("General")
  sampleCallId       String?
  status             String      @default("open") // "open" | "in_review" | "added_to_kb" | "dismissed"
  lastAskedAt        DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId, expiresAt])
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  eventType String   // "LOGIN_FAILED" | "LOGIN_SUCCESS" | "RATE_LIMIT_EXCEEDED" | "PASSWORD_RESET_REQUESTED" | "PASSWORD_RESET_SUCCESS" | "UNAUTHORIZED_ACCESS_ATTEMPT"
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([userId])
}

model SentimentAnalysis {
  id                      String      @id @default(cuid())
  callRecordId            String
  callRecord              CallRecord  @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  customerId              String?
  customer                User?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sentiment               String      // "POSITIVE" | "NEGATIVE" | "NEUTRAL" | "FRUSTRATED"
  confidenceScore         Float       // 0.0 to 1.0
  reason                  String?
  triggerText             String?
  language                String?     @default("en") // "en" | "ta" | "te" | "ml" | "hi"
  requiresHumanAssistance Boolean     @default(false)
  isFinal                 Boolean     @default(false)
  customerExperienceNote  String?
  detectedAt              DateTime    @default(now())

  @@index([callRecordId])
  @@index([sentiment, detectedAt])
  @@index([customerId])
}

model BusinessReport {
  id               String   @id @default(cuid())
  reportType       String   // "daily" | "monthly" | "custom"
  title            String
  startDate        DateTime
  endDate          DateTime
  generatedAt      DateTime @default(now())
  generatedBy      String   @default("system") // "system" | "admin"
  status           String   @default("completed") // "completed" | "processing" | "failed"
  reportData       String   // JSON string containing all calculated KPIs, charts data, and tables
  executiveSummary String?
  pdfPath          String?
  csvPath          String?
  createdAt        DateTime @default(now())

  @@index([reportType, startDate, endDate])
  @@index([generatedAt])
}

model CallRecording {
  id              String      @id @default(cuid())
  callRecordId    String      @unique
  callRecord      CallRecord  @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  callId          String      // Unique external call ID string
  storagePath     String?     // Path on server disk (e.g. uploads/recordings/...)
  fileName        String?
  fileSize        Int?        // in bytes
  mimeType        String?     @default("audio/webm")
  duration        Int         @default(0) // in seconds
  consentStatus   String      @default("granted") // "granted" | "declined" | "not_requested"
  recordingStatus String      @default("completed") // "completed" | "processing" | "declined" | "deleted"
  audioQuality    String?     @default("good")
  retentionExpiry DateTime?
  downloadCount   Int         @default(0)
  lastAccessedAt  DateTime?
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  conversationAnalysis ConversationAnalysis?
  auditLogs            RecordingAuditLog[]

  @@index([callId])
  @@index([consentStatus])
  @@index([recordingStatus])
  @@index([createdAt])
}

model ConversationAnalysis {
  id                    String        @id @default(cuid())
  callRecordId          String        @unique
  callRecord            CallRecord    @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  recordingId           String?       @unique
  recording             CallRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  
  // Customer Analysis
  customerReason        String        // Main reason for contacting
  customerRequirements  String        // Key needs / requirements
  questionsAsked        String        // JSON array of customer questions
  problemsReported      String        // JSON array of reported problems
  productsMentioned     String        // JSON array of products/services referenced
  unresolvedConcerns    String?       // JSON array of open issues
  satisfactionIndicator String        @default("neutral") // "high" | "moderate" | "low"
  overallSentiment      String        @default("NEUTRAL") // POSITIVE | NEGATIVE | NEUTRAL | FRUSTRATED

  // Conversation Analysis
  discussionPoints      String        // JSON array of main discussion points
  issuesResolved        String        // JSON array of resolved points
  issuesUnresolved      String?       // JSON array of unresolved items
  requiresHumanAssistance Boolean     @default(false)
  followUpRequired      Boolean       @default(false)
  followUpAction        String?
  customerFeedback      String?
  importantKeywords     String        // JSON array of detected keywords/tags
  callSummary           String        // Concise factual call summary (3-4 sentences)

  // Growth & Intelligence Category
  inquiryCategory       String        @default("General") // "Order" | "Product" | "Payment" | "Account" | "Technical" | "General"
  growthOpportunity     String?       // Identified business growth opportunity / signal

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([inquiryCategory])
  @@index([overallSentiment])
  @@index([createdAt])
}

model AgentPerformanceEvaluation {
  id                    String      @id @default(cuid())
  callRecordId          String      @unique
  callRecord            CallRecord  @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  agentId               String
  agent                 User        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  // 5 Pillars of Evaluation (0 to 100 each)
  communicationScore    Float       @default(80.0) // 30% weight: clarity, professional language, politeness
  resolutionScore       Float       @default(80.0) // 30% weight: issue resolved, relevant answer, avoided unnecessary transfers
  knowledgeScore        Float       @default(80.0) // 20% weight: answer relevance, product/policy accuracy
  professionalismScore  Float       @default(85.0) // 10% weight: active listening, tone, courtesy
  feedbackScore         Float       @default(80.0) // 10% weight: customer rating & sentiment on call
  overallScore          Float       @default(81.0) // Weighted composite score (0-100)

  // Evaluation Breakdown & Supporting Evidence
  evaluationSummary     String      // Objective summary of agent handling
  strengths             String      // JSON array of strong points with transcript excerpts
  improvements          String      // JSON array of constructive improvement areas
  trainingRecommendations String?   // Recommended training modules/topics
  communicationMistakes String?     // Specific communication flaws detected if any
  evidenceExcerpts      String?     // JSON array of { timestamp, quote, note }

  // Review & Management Override
  isManagerReviewed     Boolean     @default(false)
  managerNotes          String?
  reviewedBy            String?
  reviewedAt            DateTime?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([agentId])
  @@index([overallScore])
  @@index([createdAt])
}

model RecordingAuditLog {
  id            String        @id @default(cuid())
  recordingId   String
  recording     CallRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  action        String        // "PLAYBACK" | "DOWNLOAD" | "DELETE" | "CONSENT_RECORDED" | "TRANSCRIPT_CORRECTED"
  performedBy   String        // User ID or name/email
  userRole      String        // "admin" | "manager" | "system"
  ipAddress     String?
  userAgent     String?
  details       String?
  timestamp     DateTime      @default(now())

  @@index([recordingId])
  @@index([action, timestamp])
}


